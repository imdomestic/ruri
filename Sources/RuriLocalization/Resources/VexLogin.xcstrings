    "VexLogin.chooseProject" : {
      "comment" : "%@ 为可选项目名称列表。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select a project with --project. Available projects: %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请使用 --project 选择项目。可选项目：%@。"
          }
        }
      }
    },
    "VexLogin.chooseServer" : {
      "comment" : "%@ 为可选服务器名称列表。",
