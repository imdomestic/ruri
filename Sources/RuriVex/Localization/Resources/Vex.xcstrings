    "Vex.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect to a self-hosted Vex server to browse projects and launch mod preview rooms."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接自托管的 Vex 服务器，浏览项目并进入模组预览房间。"
          }
        }
      }
    },
    "Vex.disabled" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vex is disabled. Enable it in Experimental Features or run: ruri config set experimental.vex.enabled true --scope app"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vex 尚未启用。请在实验性功能中开启，或执行：ruri config set experimental.vex.enabled true --scope app"
          }
        }
      }
    },
