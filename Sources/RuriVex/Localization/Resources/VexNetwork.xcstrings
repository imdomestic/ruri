        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTPS 服务器地址；CLI 仅允许回环地址使用 HTTP。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTPS 伺服器位址；CLI 僅允許回環位址使用 HTTP。"
          }
        }
      }
    },
